{% if product %}
<div class="wlapp-product-button" data-wishlist-root data-wishlist-product-button data-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-variant-title="{{ product.selected_or_first_available_variant.title | escape }}" data-available="{{ product.selected_or_first_available_variant.available }}" data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}" data-product-image="{{ product.featured_image | image_url: width: 800 | escape }}" data-label="{{ block.settings.label | escape }}" data-color="{{ block.settings.color }}">
  <button type="button" class="wlapp-button" data-wishlist-button aria-label="{{ block.settings.label | escape }}">
    <span class="wlapp-icon" data-wishlist-icon aria-hidden="true"><svg width="1em" height="1em" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg"><path d="M25 39.7l-.6-.5C11.5 28.7 8 25 8 19c0-5 4-9 9-9 4.1 0 6.4 2.3 8 4.1 1.6-1.8 3.9-4.1 8-4.1 5 0 9 4 9 9 0 6-3.5 9.7-16.4 20.2l-.6.5zM17 12c-3.9 0-7 3.1-7 7 0 5.1 3.2 8.5 15 18.1 11.8-9.6 15-13 15-18.1 0-3.9-3.1-7-7-7-3.5 0-5.4 2.1-6.9 3.8L25 17.1l-1.1-1.3C22.4 14.1 20.5 12 17 12z" fill="currentColor"/></svg></span><span data-wishlist-label>{{ block.settings.label }}</span>
  </button>
</div>
{% endif %}
{% schema %}
{
  "name": "Wishlist button",
  "target": "section",
  "javascript": "wishlist.js",
  "stylesheet": "wishlist.css",
  "settings": [
    { "type": "text", "id": "label", "label": "Button label", "default": "Save to wishlist" },
    { "type": "color", "id": "color", "label": "Accent color", "default": "#FF5C01" }
  ]
}
{% endschema %}
